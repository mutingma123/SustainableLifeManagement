
@misc{Hart2024,
  author = {Hanna Hart},
  title = {Productivity And The Hard Truth About Time Management},
  year = {2024},
  month = {January},
  url = {https://www.forbes.com/sites/hannahart/2024/01/25/productivity-and-the-hard-truth-about-time-management/},
  abstract = {Traditional time management strategies often fail due to the finite nature of human lifespan (around 4000 weeks), forcing individuals to confront limitations and make hard choices among competing priorities rather than attempting to optimize everything. Embracing finitude involves accepting trade-offs, choosing intentional constraints to value relationships and presence, and shifting focus from future mastery over time to meaningful engagement in the present, thereby reducing the illusion of control and clarifying priorities amid cognitive and temporal constraints. This perspective directly addresses the challenge of allocating limited time and mental energy across dynamic personal and professional demands where not everything can be accomplished.},
  note = {Accessed: January 25, 2026}
}

@misc{Robinson2024,
  author = {Bryan Robinson},
  title = {4 Steps To Mitigate Cognitive Overload And Career Stress Before 2025},
  year = {2024},
  month = {November},
  url = {https://www.forbes.com/sites/bryanrobinson/2024/11/02/4-steps-to-mitigate-cognitive-overload-and-career-stress-before-2025/},
  abstract = {Cognitive overload from excessive information, job demands, technology, and workplace pressures leads to substantial productivity losses, including billions of lost working days annually from mental health issues. Mitigation strategies include streamlining information, investing in training and mental health resources, promoting deep work with breaks, and ensuring equitable workload distribution to prevent burnout. These approaches aim to better allocate limited cognitive resources and time in uncertain, high-pressure career environments to sustain performance and well-being.},
  note = {Accessed: January 25, 2026}
}

@misc{Reinhart2025,
  author = {Eric Reinhart},
  title = {What we lose when we surrender care to algorithms},
  year = {2025},
  month = {November},
  url = {https://www.theguardian.com/us-news/ng-interactive/2025/nov/09/healthcare-artificial-intelligence-ai},
  abstract = {Reliance on AI in healthcare, such as algorithmic scribes, promises efficiency but risks depleting human cognitive resources by favoring data summaries over nuanced listening, leading to decision-making that overlooks emotional and contextual uncertainties in patient care. This fosters cognitive miserliness, deskilling, and alienation in dynamic clinical interactions where incomplete or biased data heightens uncertainty. While short-term productivity gains occur in documentation, long-term costs include reduced care quality, physician burnout, and structural issues, highlighting trade-offs in allocating human attention and recovery needs when systems evolve with AI integration.},
  note = {Accessed: January 25, 2026}
}

@misc{McGregor2023,
  author = {Jena McGregor},
  title = {The Future Of Work 50 2023},
  year = {2023},
  month = {November},
  url = {https://www.forbes.com/sites/jenamcgregor/2023/11/08/the-future-of-work-50-2023/},
  abstract = {The 2023 list spotlights leaders addressing AI's dual role in replacing jobs or reducing tedium, alongside persistent hybrid work models despite return-to-office pushes. Investments like PwC's AI training for workers aim to boost productivity, while research shows work-from-anywhere policies can enhance performance through flexibility. These trends relate to reallocating time and cognitive resources in uncertain economic and technological landscapes to optimize efficiency and adaptation.},
  note = {Accessed: January 25, 2026}
}

@misc{Grant2019,
  author = {Adam Grant},
  title = {Productivity Isn't About Time Management. It's About Attention Management.},
  year = {2019},
  month = {March},
  url = {https://www.nytimes.com/2019/03/28/smarter-living/productivity-isnt-about-time-management-its-about-attention-management.html},
  abstract = {Productivity hinges more on managing attention than rigid time scheduling, as cognitive limitations make it difficult to sustain focus across competing demands in fast-paced environments. Shifting emphasis to attention control helps navigate dynamic task landscapes where distractions and uncertainty drain limited mental resources.},
  note = {Accessed: January 25, 2026}
}

